VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN backside_tsv_chip_b ;

# GT2N layers and custom test cells; coordinates are DBU (2000 per um).
# RDL/BRDL rails are 1.6 um wide; BPR cell rails are 0.032 um wide.
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 40000 40000 ) ;

# GT2N site is 0.042 x 0.144 um. Logic origins lie on that site grid.
# ff is two rows high; inv and buf are one row high. All are below the bridges.
COMPONENTS 5 ;
  # Separate 2 x 2 um bridge cells; contact centers are (5,5) and (15,15) um.
  - tsv_vdd GT2N_TEST_TSV_VDD + FIXED ( 8000 8000 ) N ;
  - tsv_vss GT2N_TEST_TSV_VSS + FIXED ( 28000 28000 ) N ;
  - ff gt2_6t_dffasync_x1_w31_svt + PLACED ( 12012 4032 ) N ;
  - inv gt2_6t_inv_x1_w31_svt + PLACED ( 16044 4032 ) N ;
  - buf gt2_6t_buf_x1_w31_svt + PLACED ( 20076 4032 ) N ;
END COMPONENTS

PINS 3 ;
  - VDD + NET VDD + DIRECTION INOUT + USE POWER
    + LAYER RDL ( -1600 -1600 ) ( 1600 1600 )
    + FIXED ( 20000 10000 ) N ;
  - VSS + NET VSS + DIRECTION INOUT + USE GROUND
    + LAYER RDL ( -1600 -1600 ) ( 1600 1600 )
    + FIXED ( 20000 30000 ) N ;
  - VDD_ISLAND + NET VDD + DIRECTION INOUT + USE POWER
    + LAYER RDL ( -1600 -1600 ) ( 1600 1600 )
    + FIXED ( 20000 20000 ) N ;
END PINS

# VDD_ISLAND at y=10 um is on VDD, but isolated from its y=5 um rail.
SPECIALNETS 2 ;
  - VDD
    ( PIN VDD )
    ( PIN VDD_ISLAND )
    ( tsv_vdd VDD )
    ( ff vdd )
    ( inv vdd )
    ( buf vdd )
    + USE POWER
    + ROUTED RDL 3200
      ( 2000 10000 ) ( 38000 * )
      NEW RDL 3200
      ( 2000 20000 ) ( 38000 * )
      NEW BRDL 3200
      ( 10000 2000 ) ( * 38000 )
      # Shared 0.032 um BPR rail touches each cell's vdd contact.
      NEW BPR 64
      ( 8400 4320 ) ( 31000 * )
      # Existing GT2N vias connect BPR -> BM1 -> BM2 -> BM3 -> BM4 -> BRDL.
      NEW BPR 0 ( 10000 4320 ) BV0_0
      NEW BM1 0 ( 10000 4320 ) BV1_0
      NEW BM2 0 ( 10000 4320 ) BV2_0
      NEW BM3 0 ( 10000 4320 ) BV3_0
      NEW BM4 0 ( 10000 4320 ) BV4_0
    ;
  - VSS
    ( PIN VSS )
    ( tsv_vss VSS )
    ( ff vss )
    ( inv vss )
    ( buf vss )
    + USE GROUND
    + ROUTED RDL 3200
      ( 2000 30000 ) ( 38000 * )
      NEW BRDL 3200
      ( 30000 2000 ) ( * 38000 )
      # Shared 0.032 um BPR rail touches each cell's vss contact.
      NEW BPR 64
      ( 8400 4032 ) ( 31000 * )
      # Existing GT2N vias connect BPR -> BM1 -> BM2 -> BM3 -> BM4 -> BRDL.
      NEW BPR 0 ( 30000 4032 ) BV0_0
      NEW BM1 0 ( 30000 4032 ) BV1_0
      NEW BM2 0 ( 30000 4032 ) BV2_0
      NEW BM3 0 ( 30000 4032 ) BV3_0
      NEW BM4 0 ( 30000 4032 ) BV4_0
      # The double-height flip-flop has a second ground contact at y=2.304 um.
      NEW BPR 64
      ( 8400 4608 ) ( 31000 * )
      NEW BM1 112
      ( 30000 4032 ) ( * 4608 )
      NEW BPR 0 ( 30000 4608 ) BV0_0
    ;
END SPECIALNETS

# Logical ff -> inv -> buf chain. Signal routing and input sources are not defined.
NETS 2 ;
  - n1 ( ff Q ) ( inv A ) + USE SIGNAL ;
  - n2 ( inv Y ) ( buf A ) + USE SIGNAL ;
END NETS

END DESIGN
