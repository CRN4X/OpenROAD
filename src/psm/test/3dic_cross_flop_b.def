VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN flop_chip_b ;
# DEF coordinates are stored in database units (DBU).
# With 2000 DBU per micron: 10000 DBU = 5 um, 30000 DBU = 15 um,
# and 40000 DBU = 20 um.
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 40000 40000 ) ;

COMPONENTS 3 ;
    - buf BUF_X1 + PLACED ( 5000 10000 ) N ;
    - inv INV_X1 + PLACED ( 15000 10000 ) N ;
    - ff DFF_X1 + PLACED ( 25000 10000 ) N ;
END COMPONENTS

PINS 5 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + LAYER metal1 ( 0 0 ) ( 200 200 ) + PLACED ( 0 5000 ) N ;
    - d + NET d + DIRECTION INPUT + USE SIGNAL
      + LAYER metal1 ( 0 0 ) ( 200 200 ) + PLACED ( 0 15000 ) N ;
    - q + NET q + DIRECTION OUTPUT + USE SIGNAL
      + LAYER metal1 ( 0 0 ) ( 200 200 ) + PLACED ( 40000 15000 ) N ;
# VDD is on the metal5 rail at (10000, 12800) DBU = (5 um, 6.4 um).
    - VDD + NET VDD + DIRECTION INOUT + USE POWER
      + LAYER metal5 ( -500 -500 ) ( 500 500 )
      + PLACED ( 10000 12800 ) N ;
# VSS is on the metal5 rail at (30000, 10000) DBU = (15 um, 5 um).
    - VSS + NET VSS + DIRECTION INOUT + USE GROUND
      + LAYER metal5 ( -500 -500 ) ( 500 500 )
      + PLACED ( 30000 10000 ) N ;
END PINS

# Each standard cell has metal1 VSS at y=5.0 um and VDD at y=6.4 um.
# Horizontal metal5 rails distribute power across the row. At every cell, a
# via1_0/via2_0/via3_0/via4_0 stack connects the rail down to its metal1 pin.
SPECIALNETS 2 ;
  - VDD
    ( PIN VDD )
    ( * VDD )
    + USE POWER
    + ROUTED metal5 1000     # this the width of the vdd pdn strap
      ( 0 12800 ) ( 40000 * )
      NEW metal4 0 ( 5570 12800 ) via4_0
      NEW metal3 0 ( 5570 12800 ) via3_0
      NEW metal2 0 ( 5570 12800 ) via2_0
      NEW metal1 0 ( 5570 12800 ) via1_0
      NEW metal4 0 ( 15380 12800 ) via4_0
      NEW metal3 0 ( 15380 12800 ) via3_0
      NEW metal2 0 ( 15380 12800 ) via2_0
      NEW metal1 0 ( 15380 12800 ) via1_0
      NEW metal4 0 ( 28230 12800 ) via4_0
      NEW metal3 0 ( 28230 12800 ) via3_0
      NEW metal2 0 ( 28230 12800 ) via2_0
      NEW metal1 0 ( 28230 12800 ) via1_0
    ;

  - VSS
    ( PIN VSS )
    ( * VSS )
    + USE GROUND
    + ROUTED metal5 1000
      ( 0 10000 ) ( 40000 * )
      NEW metal4 0 ( 5570 10000 ) via4_0
      NEW metal3 0 ( 5570 10000 ) via3_0
      NEW metal2 0 ( 5570 10000 ) via2_0
      NEW metal1 0 ( 5570 10000 ) via1_0
      NEW metal4 0 ( 15380 10000 ) via4_0
      NEW metal3 0 ( 15380 10000 ) via3_0
      NEW metal2 0 ( 15380 10000 ) via2_0
      NEW metal1 0 ( 15380 10000 ) via1_0
      NEW metal4 0 ( 28230 10000 ) via4_0
      NEW metal3 0 ( 28230 10000 ) via3_0
      NEW metal2 0 ( 28230 10000 ) via2_0
      NEW metal1 0 ( 28230 10000 ) via1_0
    ;
END SPECIALNETS

NETS 5 ;
    - clk ( PIN clk ) ( ff CK ) + USE SIGNAL ;
    - d ( PIN d ) ( ff D ) + USE SIGNAL ;
    - n1 ( ff Q ) ( inv A ) + USE SIGNAL ;
    - n2 ( inv ZN ) ( buf A ) + USE SIGNAL ;
    - q ( PIN q ) ( buf Z ) + USE SIGNAL ;
END NETS

END DESIGN

